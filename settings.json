{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(dir:*)",
      "Bash(cd:*)",
      "Bash(pwd:*)",
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(python:*)",
      "Bash(npx tsc:*)",
      "Bash(git --version:*)",
      "Bash(git init:*)",
      "Bash(git config:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(git push:*)",
      "Skill(kn-clarification-rules)",
      "Skill(kn-implementation-conventions)",
      "Skill(kn-response-conventions)",
      "mcp__pencil"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env*)",
      "Read(**/secrets/**)",
      "Edit(**/secrets/**)",
      "Read(**/*token*.json)",
      "Edit(**/*token*.json)",
      "Read(**/*token*.txt)",
      "Edit(**/*token*.txt)",
      "Read(**/*token*.yaml)",
      "Edit(**/*token*.yaml)",
      "Read(**/*token*.yml)",
      "Edit(**/*token*.yml)",
      "Read(**/*secret*.json)",
      "Edit(**/*secret*.json)",
      "Read(**/*secret*.txt)",
      "Edit(**/*secret*.txt)",
      "Read(**/*secret*.yaml)",
      "Edit(**/*secret*.yaml)",
      "Read(**/*secret*.yml)",
      "Edit(**/*secret*.yml)",
      "Read(**/*apikey*)",
      "Edit(**/*apikey*)",
      "Read(**/*api_key*)",
      "Edit(**/*api_key*)",
      "Read(**/*.key)",
      "Edit(**/*.key)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Read(**/*.p12)",
      "Edit(**/*.p12)",
      "Read(**/*.pfx)",
      "Edit(**/*.pfx)",
      "Read(**/id_rsa)",
      "Edit(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Edit(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Edit(**/id_ecdsa)",
      "Read(**/id_dsa)",
      "Edit(**/id_dsa)",
      "Read(**/.ssh/**)",
      "Edit(**/.ssh/**)",
      "Read(**/*.jks)",
      "Edit(**/*.jks)",
      "Read(**/*.keystore)",
      "Edit(**/*.keystore)",
      "Read(**/*service-account*)",
      "Edit(**/*service-account*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(git push -f *)",
      "Bash(git push --force*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * main)",
      "Bash(git push * master)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(docker:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/format_on_edit.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/check_console_log.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/play_sound.sh waiting"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "git diff --name-only | xargs grep -l 'console.log' 2>/dev/null && echo '⚠️ console.log残存あり' || true"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/play_sound.sh complete"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 2
  },
  "enabledPlugins": {},
  "extraKnownMarketplaces": {},
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.npmjs.org"
      ]
    },
    "excludedCommands": [
      "git"
    ]
  },
  "effortLevel": "high",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "dark",
  "skipAutoPermissionPrompt": true
}
